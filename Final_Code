#include "Arduino_LED_Matrix.h"
 
//include the "eat.h", "pacman.h", voteandwink.h", and "turnoff.h" header file that stores the frames for the animation
#include "eat.h"
#include "pacman.h"
#include "voteandwink.h"
#include "turnoff.h"
 
// make an instance of the library:
ArduinoLEDMatrix matrix;
 
void setup() {
 
  //opens serial port
  Serial.begin(9600);
 
  //introduced functions
  Serial.println("Please type 'eat' or 'pacman' to play animation");
  Serial.println( "Press reset button and type 'turn off' to powerdown");
 
  //plays startup animation on loop until typed input
    matrix.loadSequence(voteandwink);
    matrix.begin();
    matrix.play(true);
 
}
 
void loop() {
 
  //if there is an input in the Serial monitor, then...
  if (Serial.available() > 0) {
   
    // Read incoming text
    String incomingText = Serial.readStringUntil('\n'); // Read until newline
 
    // Check the received text and respond accordingly
    if (incomingText == "eat") {
 
      //prints typed input (eat)
      Serial.println("eat");
 
      //play eat animation
      matrix.loadSequence(eat);
      matrix.begin();
      matrix.play(true);
    }
 
    else if (incomingText == "pacman") {
 
      //prints typed input (pacman)
      Serial.println("pacman");
 
      //play pacman animation
      matrix.loadSequence(pacman);
      matrix.begin();
      matrix.play(true);
    }
 
    else if (incomingText == "turn off") {
 
      //prints typed input (turn off)
      Serial.println("turn off");
 
      //play turn off animation
      matrix.loadSequence(turnoff);
      matrix.begin();
      matrix.play(true);
 
      //turns off LED Matrix
      matrix.play(false);
    }
  }
}
