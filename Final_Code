      int pauseBetweenNotes = noteDuration * .5;
      delay(pauseBetweenNotes);

      // stop the tone playing:
      noTone(8);
     
      // Flame effect after the green lights
      flameEffect();
    }
  }
}

void flameEffect() {
  uint32_t colors[] = {
    pixels.Color(0, 0, 255),    
    pixels.Color(0, 255, 255),  
    pixels.Color(0, 255, 255),    
    pixels.Color(255, 255, 255),  
    pixels.Color(255, 255, 255),  
    pixels.Color(0, 0, 255),  
  };

  while (true) {
    for (int i = 0; i < NUMPIXELS; i++) {
      // Assign random flame colors to each pixel for a moving flame effect
      int colorIndex = random(0, 6); // Randomly pick one of the 6 flame colors
      pixels.setPixelColor(i, colors[colorIndex]);
    }

    // Shift the pixels upwards to create the "flame" movement
    for (int i = NUMPIXELS - 1; i > 0; i--) {
      pixels.setPixelColor(i, pixels.getPixelColor(i - 1)); // Shift colors up
    }

    // Set the first pixel to a random flame color
    pixels.setPixelColor(0, colors[random(0, 6)]);

    pixels.show(); // Update the pixel color
    delay(100); // Adjust delay to change the speed of flame movement
  }
}

